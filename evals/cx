if path == "/orders/2026-01-01/orders":
    check_market(["marketplaceIds"])
    if not q("createdAfter") and not q("lastUpdatedAfter") and not q("paginationToken"):
        fail(400, "InvalidInput", "createdAfter or lastUpdatedAfter is required")
    a = ts(q("createdAfter") or q("lastUpdatedAfter") or "2000-01-01", "createdAfter")
    e = ts(q("createdBefore"), "createdBefore") if q("createdBefore") else NOW - dt.timedelta(minutes=2)
    hits = sorted((o for o in ORD.values() if a <= ts(o["created"], "c") < e), key=lambda o: o["created"])
    size = max(1, min(100, int(q("maxResultsPerPage") or 100)))
    start = int((q("paginationToken") or "stub-0").split("-")[-1] or 0)
    doc = {"orders": [order_doc(o, set(qlist("includedData"))) for o in hits[start:start + size]], "createdBefore": iso(e)}
    if start + size < len(hits):
        doc["pagination"] = {"nextToken": "stub-%d" % (start + size)}
    reply(200, doc)

if path == "/sales/v1/orderMetrics":
    check_market(["marketplaceIds"])
    iv, gran = q("interval"), q("granularity")
    if not iv or "--" not in iv or not gran:
        fail(400, "InvalidInput", "marketplaceIds, interval (start--end) and granularity are required")
    a_s, e_s = iv.split("--", 1)
    a, e = ts(a_s, "interval start"), ts(e_s, "interval end")
    off = a.utcoffset() or dt.timedelta(0)
    rows = [o for o in ORD.values() if a <= ts(o["created"], "c") < e and (not q("asin") or o["asin"] == q("asin")) and (not q("sku") or o["sku"] == q("sku"))]

    def bucket(lo, hi):
        sel = [o for o in rows if lo <= ts(o["created"], "c") < hi]
        tot = round(sum(o["price"] for o in sel), 2)
        return {"interval": "%s--%s" % (lo.isoformat(), hi.isoformat()), "unitCount": len(sel), "orderItemCount": len(sel), "orderCount": len(sel),
                "averageUnitPrice": {"amount": round(tot / len(sel), 2) if sel else 0, "currencyCode": CUR}, "totalSales": {"amount": tot, "currencyCode": CUR}}

    if gran == "Total":
        reply(200, {"payload": [bucket(a, e)]})
    step = {"Day": 1, "Week": 7}.get(gran)
    if not step:
        fail(400, "InvalidInput", "this stand-in answers granularity Total, Day or Week")
    outl, lo = [], a
    while lo < e:
        hi = min(lo + dt.timedelta(days=step), e)
        outl.append(bucket(lo, hi))
        lo = hi
    reply(200, {"payload": outl})

