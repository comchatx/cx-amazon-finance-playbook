ORD = SD["orders"]


def order_doc(o, inc):
    M = lambda x: {"amount": "%.2f" % x, "currencyCode": CUR}
    item = {"orderItemId": o["itemCode"], "quantityOrdered": 1,
            "product": {"asin": o["asin"], "title": o["title"], "sellerSku": o["sku"], "condition": {"conditionType": "New"},
                        "price": {"unitPrice": M(o["price"])}}}
    if "TAX" in inc:
        if store == "ATVPDKIKX0DER":
            item["tax"] = {"taxCollections": [{"model": "MARKETPLACE_FACILITATOR", "responsibleParty": "AMAZON_SERVICES_INC"}],
                           "taxCalculationBreakdowns": []}
        else:
            item["tax"] = {"taxCollections": [], "taxCalculationBreakdowns": []}
    if "PROCEEDS" in inc:
        bd = [{"type": "ITEM", "subtotal": M(o["price"])}]
        if o["tax"]:
            bd.append({"type": "TAX", "subtotal": M(o["tax"])})
        item["proceeds"] = {"proceedsTotal": M(o["price"] + o["tax"]), "breakdowns": bd}
    doc = {"orderId": o["orderId"], "createdTime": o["created"], "lastUpdatedTime": o["posted"],
           "salesChannel": {"channelName": "AMAZON", "marketplaceId": store, "marketplaceName": SD["name"]}, "orderItems": [item]}
    if "FULFILLMENT" in inc:
        doc["fulfillment"] = {"fulfillmentStatus": "SHIPPED", "fulfilledBy": "AMAZON"}
    return doc


m = re.fullmatch(r"/orders/2026-01-01/orders/([0-9-]+)", path)
if m:
    o = ORD.get(m.group(1))
    if not o:
        fail(404, "NotFound", "no order %s in this marketplace" % m.group(1))
